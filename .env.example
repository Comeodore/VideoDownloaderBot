# ── Бот ────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Лимит размера итогового файла в МБ.
# Без локального Bot API server максимум 50. С ним — до 2000.
MAX_FILE_SIZE_MB=49

# (Опционально) путь к cookies.txt для Instagram / приватного контента.
# В Docker лежит на общем volume: /var/lib/telegram-bot-api/cookies.txt
COOKIES_FILE=

# Telegram user id владельца. Только он может присылать боту новый cookies.txt
# документом (горячая замена), и ему же бот пишет, когда cookies протухли.
OWNER_ID=

# Раз в сколько часов бот перезапускается ради обновления yt-dlp.
# 0 = выключить. Работает только в Docker (restart policy поднимет назад).
YTDLP_AUTO_UPDATE_HOURS=24

# Каталог данных на хосте (скачанные видео + данные Bot API server) —
# монтируется в оба контейнера. Вынеси на большой диск, если системный маленький.
VIDEODL_DATA_DIR=./data

# ── Локальный Telegram Bot API server (для файлов до 2 ГБ) ──
# Внутри docker-compose адрес сервиса — http://telegram-bot-api:8081
# Оставь пустым, чтобы использовать официальный api.telegram.org (лимит 50 МБ).
TELEGRAM_API_BASE=

# api_id и api_hash с https://my.telegram.org — НУЖНЫ только локальному серверу.
# Получить: my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
